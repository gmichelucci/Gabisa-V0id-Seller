# ==============================================================================
# VIDITEX DISTRIBUIDORA - CONFIGURAÇÃO DO AMBIENTE (.env)
# Renomeie este arquivo para .env e preencha com suas chaves reais
# ==============================================================================

# Supabase (Banco de Dados PostgreSQL & Storage de Fotos e Etiquetas)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Google Gemini AI (IA para criação de anúncios e análise de logística)
GEMINI_API_KEY=your-google-gemini-api-key

# WhatsApp Service (Microserviço Baileys local ou Evolution API remota)
EVOLUTION_API_URL=http://localhost:8085
EVOLUTION_API_KEY=your-api-key
EVOLUTION_INSTANCE_NAME=viditex

# Configurações de Fornecedor & Marketplace
MARKETPLACE_API_KEY=
# Número do WhatsApp do fornecedor/corte (com DDI e DDD, apenas dígitos)
SUPPLIER_NUMBER=5511999999999
